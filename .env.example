# Copy to .env for local development. Replace every secret before any public deployment.
POSTGRES_USER=food_ordering
POSTGRES_PASSWORD=food_ordering_dev
POSTGRES_DB=food_ordering
POSTGRES_PORT=5433
# Per-process PostgreSQL connection budget and pool wait bound.
DB_POOL_MAX=10
DB_ACQUIRE_TIMEOUT_MS=5000

API_PORT=3001
WEB_PORT=3000
# Per-API-instance checkout admission and per-cart distinct-line caps.
CHECKOUT_MAX_IN_FLIGHT=32
CART_MAX_LINES=100
# Per-account order API limits shared across API replicas through PostgreSQL.
ORDER_READS_PER_MINUTE=120
CHECKOUT_ATTEMPTS_PER_HOUR=12
ORDER_CHANGES_PER_HOUR=12
ADMIN_ORDER_CHANGES_PER_MINUTE=60
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/v1
# The local Compose API enables simulated demo payments; keep disabled on public hosts.
DEMO_PAYMENTS_ENABLED=false
APP_DOMAIN=localhost

# Generate independent random values. OTP_ENCRYPTION_KEY is 32 random bytes in base64.
JWT_ACCESS_SECRET=replace_with_random_access_secret
JWT_REFRESH_SECRET=replace_with_random_refresh_secret
OTP_PEPPER=replace_with_random_otp_pepper
OTP_ENCRYPTION_KEY=replace_with_32_random_bytes_base64
AUTH_TOKEN_HASH_SECRET=replace_with_random_token_hash_secret

REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380
REDIS_PASSWORD=replace_with_random_redis_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=food_ordering
RABBITMQ_DEFAULT_PASS=food_ordering_dev
RABBITMQ_URL=amqp://food_ordering:food_ordering_dev@127.0.0.1:5672

# Local Compose captures email in Mailpit. Production requires SMTP and Twilio credentials.
# Test adapters must never be enabled publicly.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_DELIVERY_MODE=provider

# Public merchant instructions for bank-transfer orders.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_IBAN=

# Versioned images for compose.prod.yaml (set after GHCR publishing).
API_IMAGE=ghcr.io/adilmansoor17/food-order-assessment-api:replace-with-release-tag
WEB_IMAGE=ghcr.io/adilmansoor17/food-order-assessment-web:replace-with-release-tag
